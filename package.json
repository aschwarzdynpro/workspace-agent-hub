{
  "name": "workspace-agent-hub",
  "displayName": "Workspace Agent Hub",
  "description": "One overview for Claude Code sessions across multiple isolated workspaces. Each agent only ever sees its own root.",
  "version": "0.1.0",
  "publisher": "dynamicspro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aschwarzdynpro/workspace-agent-hub"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "multi-root",
    "workspaces"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentHub",
          "title": "Workspace Agent Hub",
          "icon": "resources/hub.svg"
        }
      ]
    },
    "views": {
      "agentHub": [
        {
          "id": "agentHub.workspaces",
          "name": "Workspaces",
          "icon": "resources/hub.svg",
          "contextualTitle": "Workspace Agent Hub"
        },
        {
          "id": "agentHub.connection",
          "name": "Connection",
          "icon": "resources/hub.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentHub.workspaces",
        "contents": "No workspace roots configured yet.\n\nRoots are taken from the open multi-root workspace plus `agentHub.roots` in settings.\n\n[Add Root](command:agentHub.addRoot)\n[Install Claude Code Hooks](command:agentHub.installHooks)"
      }
    ],
    "commands": [
      {
        "command": "agentHub.newSession",
        "title": "New Claude Session",
        "category": "Agent Hub",
        "icon": "$(add)"
      },
      {
        "command": "agentHub.resumeSession",
        "title": "Resume Session",
        "category": "Agent Hub",
        "icon": "$(history)"
      },
      {
        "command": "agentHub.focusSession",
        "title": "Open Session Terminal",
        "category": "Agent Hub",
        "icon": "$(terminal)"
      },
      {
        "command": "agentHub.openTranscript",
        "title": "Open Transcript (JSONL)",
        "category": "Agent Hub",
        "icon": "$(file-text)"
      },
      {
        "command": "agentHub.refresh",
        "title": "Refresh",
        "category": "Agent Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "agentHub.showOverview",
        "title": "Show Overview",
        "category": "Agent Hub",
        "icon": "$(dashboard)"
      },
      {
        "command": "agentHub.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "Agent Hub",
        "icon": "$(plug)"
      },
      {
        "command": "agentHub.addRoot",
        "title": "Add Workspace Root",
        "category": "Agent Hub",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentHub.revealRoot",
        "title": "Reveal Root in Explorer",
        "category": "Agent Hub",
        "icon": "$(folder)"
      },
      {
        "command": "agentHub.addAllRootsToWindow",
        "title": "Open All Roots in This Window",
        "category": "Agent Hub",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "agentHub.focusNextWaiting",
        "title": "Go to Next Session Waiting for Me",
        "category": "Agent Hub",
        "icon": "$(bell-dot)"
      },
      {
        "command": "agentHub.diagnose",
        "title": "Diagnose (check Claude Code assumptions)",
        "category": "Agent Hub",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentHub.focusNextWaiting",
          "when": "view == agentHub.workspaces && agentHub.hasWaiting",
          "group": "navigation@0"
        },
        {
          "command": "agentHub.newSession",
          "when": "view == agentHub.workspaces",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.showOverview",
          "when": "view == agentHub.workspaces",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.refresh",
          "when": "view == agentHub.workspaces",
          "group": "navigation@3"
        },
        {
          "command": "agentHub.installHooks",
          "when": "view == agentHub.workspaces",
          "group": "1_setup"
        },
        {
          "command": "agentHub.addRoot",
          "when": "view == agentHub.workspaces",
          "group": "1_setup"
        },
        {
          "command": "agentHub.addAllRootsToWindow",
          "when": "view == agentHub.workspaces",
          "group": "1_setup"
        },
        {
          "command": "agentHub.diagnose",
          "when": "view == agentHub.workspaces || view == agentHub.connection",
          "group": "1_setup"
        }
      ],
      "view/item/context": [
        {
          "command": "agentHub.newSession",
          "when": "view == agentHub.workspaces && viewItem == root",
          "group": "inline@1"
        },
        {
          "command": "agentHub.resumeSession",
          "when": "view == agentHub.workspaces && viewItem == root",
          "group": "inline@2"
        },
        {
          "command": "agentHub.revealRoot",
          "when": "view == agentHub.workspaces && viewItem == root",
          "group": "2_nav"
        },
        {
          "command": "agentHub.focusSession",
          "when": "view == agentHub.workspaces && viewItem =~ /^session/",
          "group": "inline@1"
        },
        {
          "command": "agentHub.resumeSession",
          "when": "view == agentHub.workspaces && viewItem == transcript",
          "group": "inline@2"
        },
        {
          "command": "agentHub.openTranscript",
          "when": "view == agentHub.workspaces && viewItem =~ /^session/",
          "group": "2_nav"
        }
      ],
      "commandPalette": [
        {
          "command": "agentHub.focusSession",
          "when": "false"
        },
        {
          "command": "agentHub.openTranscript",
          "when": "false"
        },
        {
          "command": "agentHub.revealRoot",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Workspace Agent Hub",
      "properties": {
        "agentHub.roots": {
          "type": "array",
          "default": [],
          "markdownDescription": "Workspace roots. Each root is an isolated Claude Code working directory. An entry whose `path` matches a folder of the open workspace adds its options (`env`, `envFile`, `extraArgs`, `color`) to that folder.",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name (defaults to the folder name)"
              },
              "path": {
                "type": "string",
                "description": "Absolute path. `~` is expanded."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "repo",
                  "coordinator"
                ],
                "default": "repo",
                "description": "`coordinator` roots hold no code; they only read the hub status spool."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables for this root's Claude terminals only (e.g. customer tenant)."
              },
              "envFile": {
                "type": "string",
                "description": "Dotenv file, relative to the root, loaded into this root's Claude terminals. Keep credentials here (git-ignored) instead of in settings."
              },
              "extraArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "CLI arguments for this root, appended after `agentHub.extraArgs` (e.g. `--model`)."
              },
              "color": {
                "type": "string",
                "description": "Terminal tab color, a theme color id such as `terminal.ansiBlue`, `terminal.ansiGreen`, `terminal.ansiMagenta`."
              }
            }
          }
        },
        "agentHub.includeWorkspaceFolders": {
          "type": "boolean",
          "default": true,
          "description": "Treat every folder of the open (multi-root) workspace as a root."
        },
        "agentHub.launchMode": {
          "type": "string",
          "enum": [
            "terminal",
            "chat"
          ],
          "enumDescriptions": [
            "Spawn `claude` in an integrated terminal whose cwd is the root (default, fully supported).",
            "Open the Anthropic Claude Code chat panel for the root (requires `agentHub.chatCommandId`)."
          ],
          "default": "terminal",
          "description": "How new sessions are started."
        },
        "agentHub.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Executable used to start Claude Code in a terminal."
        },
        "agentHub.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments appended to every `claude` invocation (e.g. `--model`, `--permission-mode`)."
        },
        "agentHub.chatCommandId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command id of the Anthropic Claude Code extension used to open a chat session. Leave empty until verified from that extension's `package.json` (see `SPEC.md`)."
        },
        "agentHub.spoolPath": {
          "type": "string",
          "default": "~/.claude/hub/events.ndjson",
          "description": "NDJSON file the Claude Code hooks append to. The hub tails this file."
        },
        "agentHub.claudeHome": {
          "type": "string",
          "default": "~/.claude",
          "description": "Claude Code home directory (contains `projects/` and `settings.json`)."
        },
        "agentHub.staleAfterMinutes": {
          "type": "number",
          "default": 30,
          "description": "A session without events for this long is shown as idle."
        },
        "agentHub.notifyWhenWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a session starts waiting for you (permission or question). Skipped while you are already looking at that session's terminal."
        }
      }
    },
    "keybindings": [
      {
        "command": "agentHub.focusNextWaiting",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
